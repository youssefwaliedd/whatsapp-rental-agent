# Copy to .env and fill in. .env is gitignored — the key never leaves this machine.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.6-flash          # run /models to see what your key reaches
# RENTAL_AGENT_PROVIDER=anthropic        # needs ANTHROPIC_API_KEY instead

# --- Database ---
# Unset means SQLite in a local file, which is right for development.
# PRODUCTION MUST USE POSTGRES. SQLite allows one writer at a time and a turn
# holds its write transaction across the model call, so conversations serialise:
# ten simultaneous customers take 10.7s on SQLite and 1.1s on Postgres, measured
# with tests/concurrency_check.py.
# DATABASE_URL=postgresql+psycopg://user@localhost/rental_agent

# --- WhatsApp Cloud API (Milestone 4) ---
# From Meta → developers.facebook.com → your app → WhatsApp → API Setup.
# Use Meta's FREE TEST NUMBER. Registering a personal number with the Cloud API
# removes it from the WhatsApp app — that is a one-way door.
# WHATSAPP_PHONE_NUMBER_ID=        # numeric id, not the phone number
# WHATSAPP_ACCESS_TOKEN=           # secret; dashboard tokens expire after 24h
# WHATSAPP_APP_SECRET=             # secret; App settings → Basic → App secret
# WHATSAPP_VERIFY_TOKEN=           # any string you invent
# WHATSAPP_STAFF_NUMBER=           # where escalations go, e.g. 971500000000
# WHATSAPP_MEDIA_BASE_URL=         # public base for vehicle cards, e.g. GitHub Pages

# --- Fleet refresh ---
# Off by default: the import makes several minutes of requests against the
# operator's own server, and a scheduled job that quietly edits configuration
# on a developer's laptop is not a pleasant surprise.
# On, it runs nightly, catches up at boot if a scheduled run was missed while
# the process was down, and retries hourly after a failed import rather than
# leaving the fleet stale for a whole day. /health reports all of it.
# FLEET_REFRESH=1
# FLEET_REFRESH_HOUR=4          # local hour, 24h clock
# FLEET_REFRESH_TZ=Asia/Dubai
# FLEET_REFRESH_RETRY_MINUTES=60

# --- Payments ---
# Their brief asks for a link generated from the quoted price. Simulated unless
# set, so nothing takes money by accident. Stripe test keys are free and
# self-serve: build and demo against sk_test_ long before the operator hands
# over anything live.
# PAYMENT_PROVIDER=stripe
# STRIPE_API_KEY=sk_test_...
# PAYMENT_SUCCESS_URL=https://...
# PAYMENT_CANCEL_URL=https://...
#
# The provider's callback, so the system learns a payment arrived rather than
# only that a link was sent. Without the secret every event is refused, which is
# the right default: an unverified payment webhook lets anyone who finds the URL
# mark any booking paid.
#   stripe listen --forward-to localhost:8000/payments/stripe
# prints a whsec_ to put here, and forwards events to a local machine Stripe
# cannot otherwise reach.
# STRIPE_WEBHOOK_SECRET=whsec_...
