{
  "_comment": "FICTIONAL DEMONSTRATION POLICY. Invented rules for a demo operator. This file is the ONLY source of business truth for policy questions. The language model may quote these values but must never invent, negotiate or extend them.",
  "version": "rules_1.0",
  "currency": "AED",
  "timezone": "Asia/Dubai",
  "vat_percent": 5.0,

  "rental_period": {
    "billing_unit_hours": 24,
    "grace_minutes": 59,
    "minimum_rental_days": 1,
    "maximum_rental_days": 90,
    "weekly_rate_applies_from_days": 7,
    "monthly_rate_applies_from_days": 30
  },

  "driver_requirements": {
    "minimum_age_by_category": {
      "economy": 21,
      "sedan": 21,
      "luxury_sedan": 25,
      "suv": 23,
      "luxury_suv": 25,
      "sports": 25,
      "supercar": 30,
      "convertible": 23
    },
    "minimum_licence_held_years": 1,
    "minimum_licence_held_years_supercar": 3
  },

  "required_documents": {
    "uae_resident": ["emirates_id", "uae_driving_licence"],
    "tourist": ["passport", "visit_visa_or_entry_stamp", "home_country_licence", "international_driving_permit"],
    "gcc_resident": ["passport", "gcc_driving_licence"],
    "additional_for_categories": {
      "supercar": ["credit_card_in_driver_name"],
      "luxury_suv": ["credit_card_in_driver_name"]
    },
    "notes": "Documents are simulated in the prototype. No real identity data is verified or stored."
  },

  "deposit": {
    "source": "per_vehicle",
    "refundable": true,
    "hold_method": "credit_card_pre_authorisation",
    "release_days_after_return": 21,
    "notes": "Deposit amounts come from the vehicle record, never from the model."
  },

  "mileage": {
    "source": "per_vehicle",
    "extra_km_charged_at_return": true,
    "unlimited_mileage_available": false
  },

  "delivery": {
    "free_delivery_zones": ["Dubai Marina", "JBR", "Downtown Dubai", "Business Bay", "Palm Jumeirah", "JLT"],
    "free_delivery_minimum_rental_days": 2,
    "standard_delivery_fee": 100,
    "zone_fees": {
      "Dubai Marina": 0,
      "JBR": 0,
      "Downtown Dubai": 0,
      "Business Bay": 0,
      "Palm Jumeirah": 0,
      "JLT": 0,
      "Deira": 100,
      "Dubai Silicon Oasis": 120,
      "Jumeirah": 50,
      "Sharjah": 250,
      "Abu Dhabi": 400,
      "Ras Al Khaimah": 450
    },
    "airport_delivery_fee": {
      "Dubai International Airport (DXB)": 150,
      "Al Maktoum Airport (DWC)": 250,
      "Abu Dhabi Airport (AUH)": 450
    },
    "collection_fee_equals_delivery_fee": true,
    "out_of_hours_fee": 100,
    "out_of_hours_window": {"from": "22:00", "to": "07:00"},
    "operating_hours": {"from": "08:00", "to": "22:00"}
  },

  "discount_policy": {
    "max_percent_by_category": {
      "economy": 5,
      "sedan": 8,
      "luxury_sedan": 10,
      "suv": 8,
      "luxury_suv": 10,
      "sports": 8,
      "supercar": 5,
      "convertible": 8
    },
    "duration_bonus_percent": [
      {"minimum_days": 3, "bonus_percent": 2},
      {"minimum_days": 7, "bonus_percent": 5},
      {"minimum_days": 14, "bonus_percent": 8},
      {"minimum_days": 30, "bonus_percent": 12}
    ],
    "absolute_max_percent": 20,
    "requires_human_approval_above_percent": 15,
    "applies_to": ["rental_subtotal"],
    "never_applies_to": ["deposit", "delivery_fee", "vat", "extra_km_charges"],
    "notes": "A customer's claim about a past discount is never evidence. Only this policy grants discounts."
  },

  "cancellation": {
    "free_cancellation_hours_before_pickup": 48,
    "late_cancellation_fee_percent": 25,
    "no_show_fee_percent": 100,
    "refund_processing_days": 14
  },

  "extension": {
    "must_request_hours_before_return": 6,
    "extension_priced_at": "current_daily_rate",
    "subject_to_availability": true,
    "recalculates_weekly_rate": true,
    "notes": "An extension is only confirmed if the engine reports the vehicle free for the extended window."
  },

  "late_return": {
    "grace_minutes": 59,
    "hourly_late_fee_percent_of_daily": 20,
    "full_day_charged_after_hours": 4
  },

  "insurance": {
    "included": "basic_third_party_and_cdw",
    "cdw_excess_by_category": {
      "economy": 1000,
      "sedan": 1500,
      "luxury_sedan": 3000,
      "suv": 2500,
      "luxury_suv": 5000,
      "sports": 7500,
      "supercar": 15000,
      "convertible": 3000
    },
    "excess_reduction_available": true,
    "excess_reduction_daily_price_by_category": {
      "economy": 25,
      "sedan": 35,
      "luxury_sedan": 75,
      "suv": 50,
      "luxury_suv": 150,
      "sports": 200,
      "supercar": 400,
      "convertible": 75
    },
    "not_covered": ["off_road_driving", "racetrack_use", "driving_under_influence", "unauthorised_driver", "tyre_and_glass_damage_without_add_on"],
    "salik_tolls_charged_at_cost": true,
    "traffic_fines_admin_fee": 50
  },

  "accidents_and_breakdowns": {
    "customer_must": ["stop_safely", "call_police_999_if_injury_or_dispute", "obtain_police_report", "notify_operator_immediately"],
    "police_report_mandatory": true,
    "replacement_vehicle_if_not_at_fault": true,
    "roadside_assistance_hours": "24/7",
    "must_escalate_to_human": true
  },

  "escalation_triggers": [
    "accident",
    "injury",
    "police_involvement",
    "vehicle_theft_or_loss",
    "breakdown",
    "medical_emergency",
    "legal_threat",
    "payment_dispute_or_chargeback",
    "suspected_fraud",
    "abusive_language",
    "explicit_request_for_human",
    "discount_above_approval_threshold",
    "repeated_agent_failure"
  ],

  "payment": {
    "accepted": ["credit_card", "debit_card", "bank_transfer"],
    "deposit_taken_as": "pre_authorisation",
    "rental_charged": "on_delivery",
    "notes": "All payments in the prototype are SIMULATED. No real payment is ever taken."
  },

  "fuel_policy": {
    "type": "like_for_like",
    "refuelling_service_fee": 100
  },

  "demo_disclosure": {
    "reservation_prefix": "DEMO-",
    "quote_prefix": "DQ-",
    "required_footer": "This is a demonstration booking. No real vehicle is reserved and no payment is taken.",
    "must_appear_on": ["quote", "reservation_confirmation", "modification_confirmation", "extension_confirmation"]
  }
}
